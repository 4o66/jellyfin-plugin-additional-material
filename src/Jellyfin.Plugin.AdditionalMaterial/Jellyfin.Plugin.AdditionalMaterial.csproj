<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.AdditionalMaterial</RootNamespace>
    <AssemblyVersion>1.5.0.0</AssemblyVersion>
    <FileVersion>1.5.0.0</FileVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisMode>Default</AnalysisMode>
    <!-- The server provides Jellyfin's own assemblies at run time; we ship our DLL and Tomlyn.dll
         (the TOML reader for the rule files), which publish copies beside it. -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Jellyfin.Controller" Version="12.1.0" ExcludeAssets="runtime" />
    <PackageReference Include="Jellyfin.Model" Version="12.1.0" ExcludeAssets="runtime" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" ExcludeAssets="runtime" />
    <PackageReference Include="Tomlyn" Version="2.10.1" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Configuration\configPage.html" />
    <EmbeddedResource Include="Web\additional-material.js" />
    <EmbeddedResource Include="Web\i18n\*.json" />
    <!-- The helper script's rules and note text: the plugin builds archives with the same ones. -->
    <EmbeddedResource Include="..\..\tools\rules\*.toml" LogicalName="Rules.%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\tools\i18n\*.json" LogicalName="Notes.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
